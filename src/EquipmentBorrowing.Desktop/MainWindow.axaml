<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
        xmlns:views="using:EquipmentBorrowing.Desktop.Views"
        x:Class="EquipmentBorrowing.Desktop.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Campus Equipment Borrowing System"
        Width="800" Height="500">

  <Window.DataTemplates>
    <DataTemplate DataType="vm:EquipmentViewModel">
      <views:EquipmentView/>
    </DataTemplate>
    <DataTemplate DataType="vm:BorrowingsViewModel">
      <views:BorrowingsView/>
    </DataTemplate>
  </Window.DataTemplates>

  <Grid ColumnDefinitions="180,*">
    <StackPanel Grid.Column="0" Background="#222" Spacing="4" Margin="0">
      <Button Content="Equipment" Command="{Binding ShowEquipmentCommand}"
              HorizontalAlignment="Stretch" Margin="8"/>
      <Button Content="Active Borrowings" Command="{Binding ShowBorrowingsCommand}"
              HorizontalAlignment="Stretch" Margin="8"/>
    </StackPanel>

    <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" Margin="0"/>
  </Grid>
</Window>