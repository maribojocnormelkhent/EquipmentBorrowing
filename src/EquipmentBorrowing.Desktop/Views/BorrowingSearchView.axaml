<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             xmlns:views="using:EquipmentBorrowing.Desktop.Views"
             x:Class="EquipmentBorrowing.Desktop.Views.BorrowingSearchView"
             x:DataType="vm:BorrowingSearchViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="16">
    <TextBlock Grid.Row="0" Text="Borrowing Records" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <StackPanel>
        <TextBlock Text="Search (student, student number or item)" FontSize="11"/>
        <TextBox Text="{Binding SearchText}" Width="260"/>
      </StackPanel>
      <StackPanel>
        <TextBlock Text="Status" FontSize="11"/>
        <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" Width="120"/>
      </StackPanel>
      <StackPanel>
        <TextBlock Text="Sort by" FontSize="11"/>
        <ComboBox ItemsSource="{Binding SortFieldOptions}" SelectedItem="{Binding SelectedSortField}" Width="170"/>
      </StackPanel>
      <StackPanel>
        <TextBlock Text="Direction" FontSize="11"/>
        <ComboBox ItemsSource="{Binding DirectionOptions}" SelectedItem="{Binding SelectedDirection}" Width="130"/>
      </StackPanel>
    </StackPanel>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <Button Content="Search" Command="{Binding SearchCommand}"/>
      <Button Content="Reset" Command="{Binding ResetCommand}"/>
      <TextBlock Text="Loading..." IsVisible="{Binding IsLoading}" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding Message}" Foreground="OrangeRed" IsVisible="{Binding MessageIsError}"
                 VerticalAlignment="Center" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Message}" Foreground="Gray" IsVisible="{Binding !MessageIsError}"
                 VerticalAlignment="Center" TextWrapping="Wrap"/>
    </StackPanel>

    <ListBox Grid.Row="3" ItemsSource="{Binding Records}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <views:BorrowingCard/>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>