<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             xmlns:views="using:EquipmentBorrowing.Desktop.Views"
             x:Class="EquipmentBorrowing.Desktop.Views.BorrowingsView"
             x:DataType="vm:BorrowingsViewModel">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
      <TextBlock Text="Active Borrowings" FontSize="20" FontWeight="Bold"/>
      <Button Content="Reload" Command="{Binding ReloadCommand}"/>
      <TextBlock Text="Loading..." IsVisible="{Binding IsLoading}" VerticalAlignment="Center"/>
    </StackPanel>

    <TextBlock Grid.Row="1" Text="{Binding EmptyMessage}" Foreground="Gray" Margin="0,0,0,8"/>

    <ListBox Grid.Row="2" ItemsSource="{Binding ActiveBorrowings}"
             SelectedItem="{Binding SelectedBorrowing}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <views:BorrowingCard/>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <StackPanel Grid.Row="3" Margin="0,12,0,0" Spacing="8">
      <Button Content="Return Equipment" Command="{Binding ReturnCommand}"
              HorizontalAlignment="Left"/>
      <TextBlock Text="{Binding StatusMessage}" Foreground="OrangeRed" TextWrapping="Wrap"/>
    </StackPanel>
  </Grid>
</UserControl>