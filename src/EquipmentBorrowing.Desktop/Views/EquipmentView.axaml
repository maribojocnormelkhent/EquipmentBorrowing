<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             x:Class="EquipmentBorrowing.Desktop.Views.EquipmentView"
             x:DataType="vm:EquipmentViewModel">
  <Grid RowDefinitions="Auto,*,Auto" Margin="16">
    <TextBlock Grid.Row="0" Text="Equipment" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

    <ListBox Grid.Row="1" ItemsSource="{Binding EquipmentItems}"
             SelectedItem="{Binding SelectedEquipment}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Padding="8" Margin="0,2" BorderThickness="1" BorderBrush="Gray" CornerRadius="4">
            <StackPanel>
              <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
              <TextBlock Text="{Binding Id, StringFormat='ID: {0}'}" FontSize="11"/>
              <TextBlock FontSize="11">
                <TextBlock.Text>
                  <MultiBinding StringFormat="Status: {0}">
                    <Binding Path="IsAvailable"/>
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <StackPanel Grid.Row="2" Margin="0,12,0,0" Spacing="8">
      <ComboBox ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent}"
                PlaceholderText="Select student">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Name}"/>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <DatePicker SelectedDate="{Binding ExpectedReturnDate}"/>

      <Button Content="Borrow Equipment" Command="{Binding BorrowCommand}"
              HorizontalAlignment="Left"/>

      <TextBlock Text="{Binding StatusMessage}" Foreground="OrangeRed" TextWrapping="Wrap"/>
    </StackPanel>
  </Grid>
</UserControl>